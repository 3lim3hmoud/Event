rules_version = '2';
service cloud.firestore {
 match /databases/{db}/documents {
  function admin(){return request.auth!=null;}
  match /config/main {
   allow get: if true;
   allow write: if admin();
   allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
     && request.resource.data.count==resource.data.count+1
     && request.resource.data.count<=resource.data.limit;
  }
  match /students/{id} {
   allow get: if true;
   allow list, delete: if admin();
   allow create: if get(/databases/$(db)/documents/config/main).data.open==true && request.resource.data.checkedIn==false;
   allow update: if admin()
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn','at','by'])
        && exists(/databases/$(db)/documents/staff/$(request.resource.data.by)))
    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','nameEn','photo','phone']);
  }
  match /staff/{c} { allow get: if true; allow write, list: if admin(); }
  match /feedback/{id} {
   allow create: if request.resource.data.keys().hasOnly(['stars','comment','ts']) && request.resource.data.stars in [1,2,3,4,5];
   allow get, list, delete: if admin();
  }
  match /uniq/{u} { allow get, create: if true; allow delete: if admin(); }
 }
}
